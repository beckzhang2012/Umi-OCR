// ====================================================// =============== 统计页面 ===============// ====================================================import QtQuick 2.15import QtQuick.Controls 2.15import QtQuick.Layouts 1.15import QtCharts 2.15import "../Components"import "../Configs"PageContainer {    id: statisticsPage    title: qsTr("统计")    // 配置组件    property Configs_ configsComp: Configs_ {        id: configs        configName: "Statistics"        ConfigGroup {            id: vocabConfig            title: qsTr("词汇统计")            ConfigSpinBox {                id: minWordLength                title: qsTr("最小词汇长度")                value: 2                minValue: 1                maxValue: 10                step: 1            }        }    }    // 主布局    ColumnLayout {        anchors.fill: parent        spacing: 10        // 统计卡片网格        GridLayout {            id: statsGrid            columns: 2            rows: 3            spacing: 10            Layout.fillWidth: true            Layout.fillHeight: true            // 总识别次数            StatCard {                id: totalCountCard                title: qsTr("总识别次数")                value: pySideWidget.statistics["total_count"] || 0                icon: "fa-bar-chart"            }            // 今日识别次数            StatCard {                id: todayCountCard                title: qsTr("今日识别次数")                value: pySideWidget.statistics["today_count"] || 0                icon: "fa-calendar-day"            }            // 本周识别次数            StatCard {                id: weekCountCard                title: qsTr("本周识别次数")                value: pySideWidget.statistics["week_count"] || 0                icon: "fa-calendar-week"            }            // 本月识别次数            StatCard {                id: monthCountCard                title: qsTr("本月识别次数")                value: pySideWidget.statistics["month_count"] || 0                icon: "fa-calendar-alt"            }            // 识别成功率            StatCard {                id: successRateCard                title: qsTr("识别成功率")                value: pySideWidget.statistics["success_rate"] ? (pySideWidget.statistics["success_rate"] * 100).toFixed(1) + "%" : "0%"                icon: "fa-check-circle"            }            // 平均置信度            StatCard {                id: avgConfidenceCard                title: qsTr("平均置信度")                value: pySideWidget.statistics["avg_confidence"] ? (pySideWidget.statistics["avg_confidence"] * 100).toFixed(1) + "%" : "0%"                icon: "fa-percentage"            }        }        // 时间趋势图        ChartContainer {            id: trendChartContainer            title: qsTr("最近30天识别次数趋势")            Layout.fillWidth: true            Layout.preferredHeight: 300            // 折线图            LineChart {                id: trendChart                anchors.fill: parent                xAxis: DateTimeAxis {                    format: "MM-dd"                    titleText: qsTr("日期")                }                yAxis: ValueAxis {                    titleText: qsTr("识别次数")                    min: 0                }                // 识别次数系列                LineSeries {                    id: countSeries                    name: qsTr("识别次数")                    color: "#4CAF50"                    pointsVisible: true                    pointLabelsVisible: true                }            }        }        // 词汇统计        ColumnLayout {            id: vocabLayout            Layout.fillWidth: true            spacing: 10            // 词汇统计标题和控制            RowLayout {                Layout.fillWidth: true                Label {                    text: qsTr("词汇统计 - 出现频率最高的词汇")                    font.bold: true                }                IconButton {                    id: refreshVocabBtn                    icon: "fa-sync-alt"                    onClicked: pySideWidget.refreshVocabularyStatistics(minWordLength.value)                }            }            // 词汇列表            ListView {                id: vocabListView                Layout.fillWidth: true                Layout.preferredHeight: 200                model: pySideWidget.vocabulary_statistics                delegate: VocabItem {                    word: modelData.word                    count: modelData.count                    frequency: modelData.frequency                }                ScrollBar.vertical: ScrollBar {}            }        }        // 导出按钮        RowLayout {            id: exportLayout            Layout.alignment: Qt.AlignRight            spacing: 10            IconButton {                id: exportJsonBtn                icon: "fa-file-export"                text: qsTr("导出JSON")                onClicked: pySideWidget.exportStatistics("json")            }            IconButton {                id: exportCsvBtn                icon: "fa-file-csv"                text: qsTr("导出CSV")                onClicked: pySideWidget.exportStatistics("csv")            }        }    }    // 初始化    Component.onCompleted: {        pySideWidget.loadStatistics()        pySideWidget.refreshVocabularyStatistics(minWordLength.value)    }    // 更新图表数据    function updateTrendChart(data) {        countSeries.clear()        for (let i = 0; i < data.length; i++) {            countSeries.append(new Date(data[i].date), data[i].count)        }    }    // 更新词汇统计    function updateVocabularyStatistics(data) {        pySideWidget.vocabulary_statistics = data    }    // 接收Python信号    Connections {        target: pySideWidget        onStatisticsUpdated: {            updateTrendChart(pySideWidget.trend_data)            updateVocabularyStatistics(pySideWidget.vocabulary_statistics)        }    }}// ====================================================// =============== 统计卡片组件 ===============// ====================================================Component {    id: statCardComponent    Item {        id: statCard        property string title        property var value        property string icon        width: 200        height: 100        Rectangle {            anchors.fill: parent            color: "#f5f5f5"            radius: 8            border.color: "#e0e0e0"            border.width: 1        }        ColumnLayout {            anchors.fill: parent            anchors.margins: 10            spacing: 5            Label {                text: statCard.title                font.size: 12                color: "#666"            }            Label {                text: statCard.value                font.size: 24                font.bold: true                color: "#333"            }            FontAwesomeIcon {                icon: statCard.icon                size: 24                color: "#4CAF50"            }        }    }}// ====================================================// =============== 词汇项组件 ===============// ====================================================Component {    id: vocabItemComponent    Item {        id: vocabItem        property string word        property int count        property string frequency        width: parent.width        height: 40        RowLayout {            anchors.fill: parent            anchors.margins: 5            spacing: 10            Label {                text: vocabItem.word                font.bold: true                Layout.fillWidth: true            }            Label {                text: vocabItem.count                color: "#666"            }            Label {                text: vocabItem.frequency                color: "#999"            }        }    }}// ====================================================// =============== 图表容器组件 ===============// ====================================================Component {    id: chartContainerComponent    Item {        id: chartContainer        property string title        width: parent.width        height: 300        Rectangle {            anchors.fill: parent            color: "#f5f5f5"            radius: 8            border.color: "#e0e0e0"            border.width: 1        }        ColumnLayout {            anchors.fill: parent            anchors.margins: 10            spacing: 5            Label {                text: chartContainer.title                font.bold: true                color: "#333"            }            Item {                id: chartPlaceholder                Layout.fillWidth: true                Layout.fillHeight: true            }        }    }}