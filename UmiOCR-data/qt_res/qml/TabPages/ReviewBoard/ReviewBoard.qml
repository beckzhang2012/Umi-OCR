// ==============================================\n// =============== 功能页：审阅看板 ===============\n// ==============================================\n\nimport QtQuick 2.15\nimport QtQuick.Controls 2.15\nimport QtQuick.Layouts 1.15\nimport QtQuick.Controls.Material 2.15\n\nimport ".."\nimport "../../Widgets"\n\nTabPage {\n    id: tabPage\n\n    // ========================= 【属性】 =========================\n\n    property var records: [] // 所有记录\n    property var filteredRecords: [] // 筛选后的记录\n    property var selectedRecords: [] // 选中的记录\n    property var currentFilters: {\n        status: "",\n        assignee: "",\n        tags: [],\n        search: ""\n    }\n    property string currentSortBy: "created_at"\n    property string currentSortOrder: "desc"\n\n    // ========================= 【组件】 =========================\n\n    // 主布局\n    ColumnLayout {\n        anchors.fill: parent\n        spacing: 10\n\n        // 工具栏\n        Rectangle {\n            Layout.fillWidth: true\n            height: 50\n            color: Theme.color.background\n            border.color: Theme.color.border\n            border.width: 1\n\n            RowLayout {\n                anchors.fill: parent\n                anchors.margins: 5\n                spacing: 10\n\n                // 搜索框\n                TextField_ {\n                    id: searchField\n                    Layout.fillWidth: true\n                    placeholderText: qsTr("搜索文本或来源...")\n                    onTextChanged: updateFilters()\n                }\n\n                // 状态筛选\n                ComboBox {\n                    id: statusCombo\n                    width: 120\n                    model: [qsTr("全部状态"), qsTr("未处理"), qsTr("已校对"), qsTr("待修改"), qsTr("已完成")]\n                    onCurrentTextChanged: updateFilters()\n                }\n\n                // 负责人筛选\n                ComboBox {\n                    id: assigneeCombo\n                    width: 120\n                    model: [qsTr("全部负责人"), "张三", "李四", "王五"]\n                    onCurrentTextChanged: updateFilters()\n                }\n\n                // 排序按钮\n                IconButton {\n                    id: sortButton\n                    icon: "sort"\n                    tooltip: qsTr("排序")\n                    onClicked: sortMenu.open()\n\n                    Menu_ {\n                        id: sortMenu\n                        x: sortButton.x\n                        y: sortButton.y + sortButton.height\n\n                        MenuItem {\n                            text: qsTr("按创建时间排序")\n                            onClicked: {\n                                currentSortBy = "created_at"\n                                currentSortOrder = currentSortOrder === "desc" ? "asc" : "desc"\n                                updateRecords()\n                            }\n                        }\n\n                        MenuItem {\n                            text: qsTr("按更新时间排序")\n                            onClicked: {\n                                currentSortBy = "updated_at"\n                                currentSortOrder = currentSortOrder === "desc" ? "asc" : "desc"\n                                updateRecords()\n                            }\n                        }\n\n                        MenuItem {\n                            text: qsTr("按置信度排序")\n                            onClicked: {\n                                currentSortBy = "confidence"\n                                currentSortOrder = currentSortOrder === "desc" ? "asc" : "desc"\n                                updateRecords()\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        // 批量操作栏\n        Rectangle {\n            Layout.fillWidth: true\n            height: 40\n            color: Theme.color.background\n            border.color: Theme.color.border\n            border.width: 1\n\n            RowLayout {\n                anchors.fill: parent\n                anchors.margins: 5\n                spacing: 10\n\n                Text {\n                    text: qsTr("已选择 %1 项").arg(selectedRecords.length)\n                    color: Theme.color.text\n                    visible: selectedRecords.length > 0\n                }\n\n                Item { Layout.fillWidth: true }\n\n                // 批量标记状态\n                ComboBox {\n                    id: batchStatusCombo\n                    width: 120\n                    model: [qsTr("批量标记状态"), qsTr("未处理"), qsTr("已校对"), qsTr("待修改"), qsTr("已完成")]\n                    visible: selectedRecords.length > 0\n                    onCurrentIndexChanged: {\n                        if (currentIndex > 0) {\n                            batchUpdate({status: currentText})\n                            currentIndex = 0\n                        }\n                    }\n                }\n\n                // 批量分配负责人\n                ComboBox {\n                    id: batchAssigneeCombo\n                    width: 120\n                    model: [qsTr("批量分配负责人"), "张三", "李四", "王五"]\n                    visible: selectedRecords.length > 0\n                    onCurrentIndexChanged: {\n                        if (currentIndex > 0) {\n                            batchUpdate({assignee: currentText})\n                            currentIndex = 0\n                        }\n                    }\n                }\n\n                // 批量导出\n                IconButton {\n                    id: exportButton\n                    icon: "export"\n                    tooltip: qsTr("批量导出")\n                    visible: selectedRecords.length > 0\n                    onClicked: exportMenu.open()\n\n                    Menu_ {\n                        id: exportMenu\n                        x: exportButton.x\n                        y: exportButton.y + exportButton.height\n\n                        MenuItem {\n                            text: qsTr("导出为Markdown")\n                            onClicked: exportRecords("markdown")\n                        }\n\n                        MenuItem {\n                            text: qsTr("导出为HTML")\n                            onClicked: exportRecords("html")\n                        }\n                    }\n                }\n\n                // 批量删除\n                IconButton {\n                    id: deleteButton\n                    icon: "delete"\n                    tooltip: qsTr("批量删除")\n                    visible: selectedRecords.length > 0\n                    onClicked: batchDelete()\n                }\n            }\n        }\n\n        // 记录列表\n        Rectangle {\n            Layout.fillWidth: true\n            Layout.fillHeight: true\n            color: Theme.color.background\n            border.color: Theme.color.border\n            border.width: 1\n\n            ListView {\n                id: recordsListView\n                anchors.fill: parent\n                model: filteredRecords\n                delegate: recordDelegate\n                clip: true\n                spacing: 5\n\n                // 记录委托\n                Component {\n                    id: recordDelegate\n                    Rectangle {\n                        width: recordsListView.width\n                        height: 120\n                        color: Theme.color.background\n                        border.color: Theme.color.border\n                        border.width: 1\n                        radius: 5\n                        \n                        property bool isSelected: selectedRecords.indexOf(modelData.id) !== -1\n                        \n                        MouseArea {\n                            anchors.fill: parent\n                            onClicked: {\n                                if (mouse.modifiers & Qt.ControlModifier) {\n                                    toggleSelection()\n                                } else {\n                                    selectRecord()\n                                }\n                            }\n                        }\n                        \n                        RowLayout {\n                            anchors.fill: parent\n                            anchors.margins: 10\n                            spacing: 10\n\n                            // 缩略图\n                            Image {\n                                id: thumbnail\n                                width: 80\n                                height: 80\n                                source: modelData.thumbnail_path || "qrc:/images/default_thumbnail.png"\n                                fillMode: Image.PreserveAspectFit\n                                border.color: Theme.color.border\n                                border.width: 1\n                            }\n\n                            // 记录信息\n                            ColumnLayout {\n                                Layout.fillWidth: true\n                                spacing: 5\n\n                                // 标题栏\n                                RowLayout {\n                                    Layout.fillWidth: true\n\n                                    Text {\n                                        text: modelData.source || qsTr("未知来源")\n                                        color: Theme.color.text\n                                        font.bold: true\n                                        elide: Text.ElideRight\n                                        Layout.fillWidth: true\n                                    }\n\n                                    CheckBox {\n                                        checked: isSelected\n                                        onClicked: toggleSelection()\n                                    }\n                                }\n\n                                // 文本摘要\n                                Text {\n                                    text: modelData.text || qsTr("无文本")\n                                    color: Theme.color.text\n                                    elide: Text.ElideRight\n                                    maximumLineCount: 2\n                                    Layout.fillWidth: true\n                                }\n\n                                // 元数据\n                                RowLayout {\n                                    Layout.fillWidth: true\n                                    spacing: 15\n\n                                    Text {\n                                        text: qsTr("状态: %1").arg(modelData.status || qsTr("未处理"))\n                                        color: Theme.color.text\n                                        font.size: 12\n                                    }\n\n                                    Text {\n                                        text: qsTr("负责人: %1").arg(modelData.assignee || qsTr("未分配"))\n                                        color: Theme.color.text\n                                        font.size: 12\n                                    }\n\n                                    Text {\n                                        text: qsTr("置信度: %1").arg(modelData.confidence || "0.0")\n                                        color: Theme.color.text\n                                        font.size: 12\n                                    }\n\n                                    Item { Layout.fillWidth: true }\n\n                                    // 操作按钮\n                                    RowLayout {\n                                        spacing: 5\n\n                                        IconButton {\n                                            icon: "edit"\n                                            tooltip: qsTr("编辑")\n                                            onClicked: editRecord()\n                                        }\n\n                                        IconButton {\n                                            icon: "delete"\n                                            tooltip: qsTr("删除")\n                                            onClicked: deleteRecord()\n                                        }\n                                    }\n                                }\n                            }\n                        }\n\n                        // 选中状态高亮\n                        Rectangle {\n                            anchors.fill: parent\n                            color: Theme.color.accent + "33"\n                            visible: isSelected\n                            radius: 5\n                        }\n\n                        // 编辑记录\n                        function editRecord() {\n                            editDialog.record = modelData\n                            editDialog.open()\n                        }\n\n                        // 删除记录\n                        function deleteRecord() {\n                            qmlapp.popup.dialog(qsTr("确认删除"), qsTr("确定要删除这条记录吗？"), (flag) => {\n                                if (flag) {\n                                    tabPage.callPy("deleteRecord", modelData.id)\n                                    updateRecords()\n                                }\n                            }, "warning")\n                        }\n\n                        // 选择记录\n                        function selectRecord() {\n                            selectedRecords = [modelData.id]\n                        }\n\n                        // 切换选择状态\n                        function toggleSelection() {\n                            const index = selectedRecords.indexOf(modelData.id)\n                            if (index !== -1) {\n                                selectedRecords.splice(index, 1)\n                            } else {\n                                selectedRecords.push(modelData.id)\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // 编辑对话框\n    EditRecordDialog {\n        id: editDialog\n        onAccepted: {\n            tabPage.callPy("updateRecord", editDialog.record.id, editDialog.updates)\n            updateRecords()\n        }\n    }\n\n    // ========================= 【方法】 =========================\n\n    // 更新筛选条件\n    function updateFilters() {\n        currentFilters = {\n            status: statusCombo.currentIndex > 0 ? statusCombo.currentText : "",\n            assignee: assigneeCombo.currentIndex > 0 ? assigneeCombo.currentText : "",\n            tags: [],\n            search: searchField.text\n        }\n        updateRecords()\n    }\n\n    // 更新记录列表\n    function updateRecords() {\n        filteredRecords = tabPage.callPy("getRecords", currentFilters, currentSortBy, currentSortOrder)\n    }\n\n    // 批量更新\n    function batchUpdate(updates) {\n        tabPage.callPy("batchUpdate", selectedRecords, updates)\n        updateRecords()\n        selectedRecords = []\n    }\n\n    // 批量删除\n    function batchDelete() {\n        qmlapp.popup.dialog(qsTr("确认批量删除"), qsTr("确定要删除选中的 %1 条记录吗？").arg(selectedRecords.length), (flag) => {\n            if (flag) {\n                tabPage.callPy("batchDelete", selectedRecords)\n                updateRecords()\n                selectedRecords = []\n            }\n        }, "warning")\n    }\n\n    // 导出记录\n    function exportRecords(format) {\n        const content = tabPage.callPy("exportRecords", selectedRecords, format)\n        const fileName = qsTr("OCR审阅看板报告_%1.%2").arg(new Date().toISOString().slice(0, 10)).arg(format)\n        qmlapp.fileDialog.saveFile(content, fileName, format === "markdown" ? "*.md" : "*.html")\n    }\n\n    // ========================= 【生命周期】 =========================\n\n    Component.onCompleted: {\n        updateRecords()\n    }\n}\n\n// 编辑记录对话框\nComponent {\n    id: EditRecordDialog\n    \n    Dialog {\n        id: dialog\n        title: qsTr("编辑记录")\n        width: 500\n        height: 400\n        modal: true\n        standardButtons: Dialog.Ok | Dialog.Cancel\n        \n        property var record: null\n        property var updates: {}\n        \n        ColumnLayout {\n            anchors.fill: parent\n            anchors.margins: 20\n            spacing: 15\n\n            // 状态\n            RowLayout {\n                Label { text: qsTr("状态:"); Layout.preferredWidth: 80 }\n                ComboBox {\n                    id: editStatusCombo\n                    Layout.fillWidth: true\n                    model: [qsTr("未处理"), qsTr("已校对"), qsTr("待修改"), qsTr("已完成")]\n                }\n            }\n\n            // 负责人\n            RowLayout {\n                Label { text: qsTr("负责人:"); Layout.preferredWidth: 80 }\n                ComboBox {\n                    id: editAssigneeCombo\n                    Layout.fillWidth: true\n                    model: [qsTr("未分配"), "张三", "李四", "王五"]\n                }\n            }\n\n            // 标签\n            RowLayout {\n                Label { text: qsTr("标签:"); Layout.preferredWidth: 80 }\n                TextField_ {\n                    id: editTagsField\n                    Layout.fillWidth: true\n                    placeholderText: qsTr("用逗号分隔多个标签")\n                }\n            }\n\n            // 备注\n            RowLayout {\n                Label { text: qsTr("备注:"); Layout.preferredWidth: 80 }\n                TextEdit_ {\n                    id: editNotesField\n                    Layout.fillWidth: true\n                    Layout.fillHeight: true\n                    placeholderText: qsTr("添加备注")\n                }\n            }\n        }\n        \n        onOpened: {\n            if (record) {\n                editStatusCombo.currentText = record.status || qsTr("未处理")\n                editAssigneeCombo.currentText = record.assignee || qsTr("未分配")\n                editTagsField.text = record.tags ? record.tags.join(", ") : ""\n                editNotesField.text = record.notes || ""\n            }\n        }\n        \n        onAccepted: {\n            updates = {\n                status: editStatusCombo.currentText,\n                assignee: editAssigneeCombo.currentText === qsTr("未分配") ? "" : editAssigneeCombo.currentText,\n                tags: editTagsField.text.split(",").map(tag => tag.trim()).filter(tag => tag),\n                notes: editNotesField.text\n            }\n        }\n    }\n}