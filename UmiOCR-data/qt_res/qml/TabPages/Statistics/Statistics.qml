// ===============================================\n// =============== 统计标签页 ===============\n// ===============================================\n\nimport QtQuick 2.15\nimport QtQuick.Layouts 1.15\nimport QtQuick.Controls 2.15\nimport QtCharts 2.15\n\nimport TagPageConnector 1.0\n\nTabPage {\n    id: tabPage\n\n    // ========================= 【页面属性】 =========================\n\n    property string ctrlKey: ""\n    property TagPageConnector connector: null\n\n    // 统计数据\n    property var statisticsData: {} \n\n    // 词汇统计最小长度\n    property int minWordLength: 2\n\n    // ========================= 【页面初始化】 =========================\n\n    Component.onCompleted: {\n        updateStatistics()\n    }\n\n    // ========================= 【页面布局】 =========================\n\n    ColumnLayout {\n        anchors.fill: parent\n        spacing: 16\n        padding: 16\n\n        // 总统计卡片\n        GridLayout {\n            columns: 4\n            spacing: 12\n\n            StatCard {\n                title: qsTr("总识别次数")\n                value: statisticsData.total_count || 0\n            }\n\n            StatCard {\n                title: qsTr("今日识别次数")\n                value: statisticsData.today_count || 0\n            }\n\n            StatCard {\n                title: qsTr("本周识别次数")\n                value: statisticsData.week_count || 0\n            }\n\n            StatCard {\n                title: qsTr("本月识别次数")\n                value: statisticsData.month_count || 0\n            }\n\n            StatCard {\n                title: qsTr("识别成功率")\n                value: String.format("%.2f%%", (statisticsData.success_rate || 0) * 100)\n            }\n\n            StatCard {\n                title: qsTr("平均置信度")\n                value: String.format("%.2f", statisticsData.avg_confidence || 0)\n            }\n\n            StatCard {\n                title: qsTr("平均识别速度")\n                value: String.format("%.2f 秒", statisticsData.avg_speed || 0)\n            }\n\n            // 占位符\n            Item {\n                Layout.fillWidth: true\n                Layout.fillHeight: true\n            }\n        }\n\n        // 图表和词汇统计\n        RowLayout {\n            Layout.fillWidth: true\n            Layout.fillHeight: true\n            spacing: 16\n\n            // 时间趋势图\n            ColumnLayout {\n                Layout.fillWidth: true\n                Layout.fillHeight: true\n                spacing: 8\n\n                Text {\n                    text: qsTr("最近30天识别次数趋势")\n                    font.bold: true\n                    font.pixelSize: 16\n                }\n\n                ChartView {\n                    id: trendChart\n                    Layout.fillWidth: true\n                    Layout.fillHeight: true\n                    antialiasing: true\n\n                    LineSeries {\n                        id: trendSeries\n                        name: qsTr("识别次数")\n                    }\n\n                    DateTimeAxis {\n                        id: xAxis\n                        format: "MM/dd"\n                        tickCount: 7\n                    }\n\n                    ValueAxis {\n                        id: yAxis\n                        min: 0\n                        max: 10\n                    }\n\n                    Component.onCompleted: {\n                        xAxis.orientation = Qt.Horizontal\n                        yAxis.orientation = Qt.Vertical\n                        trendChart.axisX = xAxis\n                        trendChart.axisY = yAxis\n                    }\n                }\n            }\n\n            // 词汇统计\n            ColumnLayout {\n                Layout.fillWidth: true\n                Layout.fillHeight: true\n                spacing: 8\n\n                RowLayout {\n                    spacing: 8\n\n                    Text {\n                        text: qsTr("高频词汇统计")\n                        font.bold: true\n                        font.pixelSize: 16\n                        Layout.fillWidth: true\n                    }\n\n                    ComboBox {\n                        id: minLengthCombo\n                        model: [1, 2, 3, 4, 5]\n                        currentIndex: 1 // 默认选择2\n                        onActivated: {\n                            minWordLength = model[currentIndex]\n                            updateStatistics()\n                        }\n                    }\n\n                    Text {\n                        text: qsTr("字符以上")\n                        font.pixelSize: 14\n                    }\n                }\n\n                ListView {\n                    id: wordListView\n                    Layout.fillWidth: true\n                    Layout.fillHeight: true\n                    spacing: 4\n\n                    model: ListModel {}\n\n                    delegate: Item {\n                        width: parent.width\n                        height: 24\n\n                        RowLayout {\n                            anchors.fill: parent\n                            spacing: 8\n\n                            Text {\n                                text: index + 1\n                                font.bold: true\n                                width: 20\n                                horizontalAlignment: Text.AlignRight\n                            }\n\n                            Text {\n                                text: word\n                                Layout.fillWidth: true\n                            }\n\n                            Text {\n                                text: count\n                                color: "#666666"\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        // 导出按钮\n        RowLayout {\n            spacing: 8\n\n            Button {\n                text: qsTr("导出为JSON")\n                onClicked: exportToJSON()\n            }\n\n            Button {\n                text: qsTr("导出为CSV")\n                onClicked: exportToCSV()\n            }\n\n            Button {\n                text: qsTr("刷新数据")\n                onClicked: updateStatistics()\n            }\n        }\n    }\n\n    // ========================= 【页面方法】 =========================\n\n    // 更新统计数据\n    function updateStatistics() {\n        statisticsData = connector.callPySync(ctrlKey, "getStatisticsData")\n        \n        // 更新时间趋势图\n        updateTrendChart()\n        \n        // 更新词汇统计列表\n        updateWordList()\n    }\n\n    // 更新时间趋势图\n    function updateTrendChart() {\n        trendSeries.clear()\n        \n        if (statisticsData.time_trend) {\n            let maxCount = 0\n            \n            for (let i = 0; i < statisticsData.time_trend.length; i++) {\n                const dateStr = statisticsData.time_trend[i][0]\n                const count = statisticsData.time_trend[i][1]\n                \n                const date = new Date(dateStr)\n                trendSeries.append(date.getTime(), count)\n                \n                if (count > maxCount) {\n                    maxCount = count\n                }\n            }\n            \n            // 设置Y轴范围\n            yAxis.max = maxCount > 0 ? maxCount : 10\n        }\n    }\n\n    // 更新词汇统计列表\n    function updateWordList() {\n        wordListView.model.clear()\n        \n        if (statisticsData.word_statistics) {\n            for (let i = 0; i < statisticsData.word_statistics.length; i++) {\n                const word = statisticsData.word_statistics[i][0]\n                const count = statisticsData.word_statistics[i][1]\n                \n                wordListView.model.append({\n                    word: word,\n                    count: count\n                })\n            }\n        }\n    }\n\n    // 导出为JSON\n    function exportToJSON() {\n        const fileDialog = Qt.createQmlObject(\n            'import QtQuick.Dialogs 1.3; FileDialog {\n                title: "导出为JSON"\n                selectExisting: false\n                selectFolder: false\n                nameFilters: ["JSON Files (*.json)"]\n            }',\n            tabPage\n        )\n        \n        fileDialog.accepted.connect(() => {\n            const path = fileDialog.fileUrl.replace("file:///", "")\n            const result = connector.callPySync(ctrlKey, "exportToJSON", path)\n            \n            if (result) {\n                Qt.createQmlObject(\n                    'import QtQuick.Dialogs 1.3; MessageDialog {\n                        title: "导出成功"\n                        text: "统计数据已成功导出为JSON文件。"\n                        standardButtons: StandardButton.Ok\n                    }',\n                    tabPage\n                ).open()\n            } else {\n                Qt.createQmlObject(\n                    'import QtQuick.Dialogs 1.3; MessageDialog {\n                        title: "导出失败"\n                        text: "统计数据导出为JSON文件失败。"\n                        standardButtons: StandardButton.Ok\n                    }',\n                    tabPage\n                ).open()\n            }\n        })\n        \n        fileDialog.open()\n    }\n\n    // 导出为CSV\n    function exportToCSV() {\n        const fileDialog = Qt.createQmlObject(\n            'import QtQuick.Dialogs 1.3; FileDialog {\n                title: "导出为CSV"\n                selectExisting: false\n                selectFolder: false\n                nameFilters: ["CSV Files (*.csv)"]\n            }',\n            tabPage\n        )\n        \n        fileDialog.accepted.connect(() => {\n            const path = fileDialog.fileUrl.replace("file:///", "")\n            const result = connector.callPySync(ctrlKey, "exportToCSV", path)\n            \n            if (result) {\n                Qt.createQmlObject(\n                    'import QtQuick.Dialogs 1.3; MessageDialog {\n                        title: "导出成功"\n                        text: "统计数据已成功导出为CSV文件。"\n                        standardButtons: StandardButton.Ok\n                    }',\n                    tabPage\n                ).open()\n            } else {\n                Qt.createQmlObject(\n                    'import QtQuick.Dialogs 1.3; MessageDialog {\n                        title: "导出失败"\n                        text: "统计数据导出为CSV文件失败。"\n                        standardButtons: StandardButton.Ok\n                    }',\n                    tabPage\n                ).open()\n            }\n        })\n        \n        fileDialog.open()\n    }\n\n    // ========================= 【自定义组件】 =========================\n\n    // 统计卡片组件\n    Component {\n        id: statCardComponent\n\n        Item {\n            id: statCard\n            width: 200\n            height: 80\n\n            Rectangle {\n                anchors.fill: parent\n                color: "#f5f5f5"\n                radius: 8\n            }\n\n            ColumnLayout {\n                anchors.fill: parent\n                anchors.margins: 12\n                spacing: 4\n\n                Text {\n                    text: ""\n                    font.pixelSize: 14\n                    color: "#666666"\n                }\n\n                Text {\n                    text: "0"\n                    font.bold: true\n                    font.pixelSize: 24\n                    color: "#333333"\n                }\n            }\n        }\n    }\n\n    // 统计卡片\n    Item {\n        id: statCard\n        property string title: ""\n        property var value: 0\n\n        width: 200\n        height: 80\n\n        Rectangle {\n            anchors.fill: parent\n            color: "#f5f5f5"\n            radius: 8\n        }\n\n        ColumnLayout {\n            anchors.fill: parent\n            anchors.margins: 12\n            spacing: 4\n\n            Text {\n                text: title\n                font.pixelSize: 14\n                color: "#666666"\n            }\n\n            Text {\n                text: value.toString()\n                font.bold: true\n                font.pixelSize: 24\n                color: "#333333"\n            }\n        }\n    }\n}