import QtQuick 2.15import QtQuick.Controls 2.15import QtQuick.Layouts 1.15import QtQuick.Dialogs 1.15Dialog {    id: editTaskDialog    title: qsTr("编辑计划任务")    width: 600    height: 500    standardButtons: Dialog.Ok | Dialog.Cancel    property alias taskName: taskNameInput.text    property alias taskType: taskTypeComboBox.currentIndex    property alias onceDateTime: onceDateTimeEdit.text    property alias dailyTime: dailyTimeEdit.text    property alias weeklyWeekday: weeklyWeekdayComboBox.currentIndex    property alias weeklyTime: weeklyTimeEdit.text    property alias cronExpression: cronExpressionInput.text    property alias ocrTemplate: ocrTemplateComboBox.currentText    property alias folders: foldersList.model    property alias retryStrategy: retryStrategyComboBox.currentIndex    property alias concurrencyLimit: concurrencyLimitInput.text    property var currentTask: null    signal taskUpdated    ColumnLayout {        anchors.fill: parent        spacing: 10        // 任务名称        RowLayout {            Layout.fillWidth: true            Label {                text: qsTr("任务名称:")                Layout.preferredWidth: 100            }            TextField {                id: taskNameInput                Layout.fillWidth: true                placeholderText: qsTr("请输入任务名称")            }        }        // 任务类型        RowLayout {            Layout.fillWidth: true            Label {                text: qsTr("任务类型:")                Layout.preferredWidth: 100            }            ComboBox {                id: taskTypeComboBox                Layout.fillWidth: true                model: [qsTr("一次性"), qsTr("每天"), qsTr("每周"), qsTr("自定义Cron")]                onCurrentIndexChanged: {                    updateScheduleFields()                }            }        }        // 一次性任务时间        RowLayout {            id: onceDateTimeRow            Layout.fillWidth: true            visible: taskTypeComboBox.currentIndex === 0            Label {                text: qsTr("执行时间:")                Layout.preferredWidth: 100            }            TextField {                id: onceDateTimeEdit                Layout.fillWidth: true                placeholderText: qsTr("YYYY-MM-DD HH:MM:SS")            }        }        // 每天任务时间        RowLayout {            id: dailyTimeRow            Layout.fillWidth: true            visible: taskTypeComboBox.currentIndex === 1            Label {                text: qsTr("执行时间:")                Layout.preferredWidth: 100            }            TextField {                id: dailyTimeEdit                Layout.fillWidth: true                placeholderText: qsTr("HH:MM:SS")            }        }        // 每周任务时间        ColumnLayout {            id: weeklyTimeColumn            Layout.fillWidth: true            visible: taskTypeComboBox.currentIndex === 2            RowLayout {                Layout.fillWidth: true                Label {                    text: qsTr("执行日期:")                    Layout.preferredWidth: 100                }                ComboBox {                    id: weeklyWeekdayComboBox                    Layout.fillWidth: true                    model: [qsTr("周日"), qsTr("周一"), qsTr("周二"), qsTr("周三"), qsTr("周四"), qsTr("周五"), qsTr("周六")]                }            }            RowLayout {                Layout.fillWidth: true                Label {                    text: qsTr("执行时间:")                    Layout.preferredWidth: 100                }                TextField {                    id: weeklyTimeEdit                    Layout.fillWidth: true                    placeholderText: qsTr("HH:MM:SS")                }            }        }        // 自定义Cron表达式        RowLayout {            id: cronExpressionRow            Layout.fillWidth: true            visible: taskTypeComboBox.currentIndex === 3            Label {                text: qsTr("Cron表达式:")                Layout.preferredWidth: 100            }            TextField {                id: cronExpressionInput                Layout.fillWidth: true                placeholderText: qsTr("例如: 0 0 * * *")            }        }        // OCR模板        RowLayout {            Layout.fillWidth: true            Label {                text: qsTr("OCR模板:")                Layout.preferredWidth: 100            }            ComboBox {                id: ocrTemplateComboBox                Layout.fillWidth: true                // 这里需要从配置中获取OCR模板列表                model: [qsTr("默认模板"), qsTr("自定义模板1"), qsTr("自定义模板2")]            }        }        // 处理文件夹        ColumnLayout {            Layout.fillWidth: true            RowLayout {                Layout.fillWidth: true                Label {                    text: qsTr("处理文件夹:")                    Layout.preferredWidth: 100                }                Button {                    text: qsTr("添加")                    onClicked: folderDialog.open()                }            }            ListView {                id: foldersList                Layout.fillWidth: true                Layout.preferredHeight: 100                model: ListModel {                    id: foldersModel                }                delegate: RowLayout {                    Layout.fillWidth: true                    Text {                        text: model.folderPath                        Layout.fillWidth: true                    }                    Button {                        text: qsTr("删除")                        onClicked: foldersModel.remove(index)                    }                }            }        }        // 失败重试策略        RowLayout {            Layout.fillWidth: true            Label {                text: qsTr("重试策略:")                Layout.preferredWidth: 100            }            ComboBox {                id: retryStrategyComboBox                Layout.fillWidth: true                model: [qsTr("不重试"), qsTr("重试一次"), qsTr("重试三次")]            }        }        // 并发限制        RowLayout {            Layout.fillWidth: true            Label {                text: qsTr("并发限制:")                Layout.preferredWidth: 100            }            TextField {                id: concurrencyLimitInput                Layout.fillWidth: true                placeholderText: qsTr("1")                validator: IntValidator { bottom: 1 }            }        }    }    function updateScheduleFields() {        onceDateTimeRow.visible = taskTypeComboBox.currentIndex === 0        dailyTimeRow.visible = taskTypeComboBox.currentIndex === 1        weeklyTimeColumn.visible = taskTypeComboBox.currentIndex === 2        cronExpressionRow.visible = taskTypeComboBox.currentIndex === 3    }    function validateTask() {        if (!taskNameInput.text.trim()) {            return qsTr("请输入任务名称")        }        if (taskTypeComboBox.currentIndex === 0 && !onceDateTimeEdit.text.trim()) {            return qsTr("请输入执行时间")        }        if (taskTypeComboBox.currentIndex === 1 && !dailyTimeEdit.text.trim()) {            return qsTr("请输入执行时间")        }        if (taskTypeComboBox.currentIndex === 2 && !weeklyTimeEdit.text.trim()) {            return qsTr("请输入执行时间")        }        if (taskTypeComboBox.currentIndex === 3 && !cronExpressionInput.text.trim()) {            return qsTr("请输入Cron表达式")        }        if (foldersModel.count === 0) {            return qsTr("请至少添加一个处理文件夹")        }        if (!concurrencyLimitInput.text.trim() || parseInt(concurrencyLimitInput.text) < 1) {            return qsTr("请输入有效的并发限制")        }        return null    }    function open(task) {        currentTask = task        // 填充表单        taskNameInput.text = task.name        if (task.type === "once") {            taskTypeComboBox.currentIndex = 0            onceDateTimeEdit.text = task.schedule        } else if (task.type === "daily") {            taskTypeComboBox.currentIndex = 1            dailyTimeEdit.text = task.schedule        } else if (task.type === "weekly") {            taskTypeComboBox.currentIndex = 2            weeklyWeekdayComboBox.currentIndex = task.schedule.weekday            weeklyTimeEdit.text = task.schedule.time        } else if (task.type === "cron") {            taskTypeComboBox.currentIndex = 3            cronExpressionInput.text = task.schedule        }        // 设置OCR模板        for (let i = 0; i < ocrTemplateComboBox.count; i++) {            if (ocrTemplateComboBox.model[i] === task.ocr_template) {                ocrTemplateComboBox.currentIndex = i                break            }        }        // 设置文件夹        foldersModel.clear()        task.folders.forEach(folder => {            foldersModel.append({ folderPath: folder })        })        // 设置重试策略        const retryStrategyIndex = ["no_retry", "retry_once", "retry_three_times"].indexOf(task.retry_strategy)        retryStrategyComboBox.currentIndex = retryStrategyIndex !== -1 ? retryStrategyIndex : 0        // 设置并发限制        concurrencyLimitInput.text = task.concurrency_limit.toString()        // 更新显示字段        updateScheduleFields()        // 打开对话框        visible = true    }    onAccepted: {        if (!currentTask) {            return        }        const error = validateTask()        if (error) {            messageDialog.text = error            messageDialog.open()            return        }        // 构建任务信息        const taskInfo = {            name: taskNameInput.text.trim(),            type: ["once", "daily", "weekly", "cron"][taskTypeComboBox.currentIndex],            schedule: null,            ocr_template: ocrTemplateComboBox.currentText,            folders: foldersModel.items.map(item => item.folderPath),            retry_strategy: ["no_retry", "retry_once", "retry_three_times"][retryStrategyComboBox.currentIndex],            concurrency_limit: parseInt(concurrencyLimitInput.text)        }        // 设置调度信息        if (taskInfo.type === "once") {            taskInfo.schedule = onceDateTimeEdit.text.trim()        } else if (taskInfo.type === "daily") {            taskInfo.schedule = dailyTimeEdit.text.trim()        } else if (taskInfo.type === "weekly") {            taskInfo.schedule = {                weekday: weeklyWeekdayComboBox.currentIndex,                time: weeklyTimeEdit.text.trim()            }        } else if (taskInfo.type === "cron") {            taskInfo.schedule = cronExpressionInput.text.trim()        }        // 更新任务        tagPagesConnector.callPy("TaskScheduler", "update_task", [currentTask.id, taskInfo])        // 清空当前任务        currentTask = null        // 发送任务更新信号        taskUpdated()    }    onRejected: {        // 清空当前任务        currentTask = null    }    // 文件夹选择对话框    FolderDialog {        id: folderDialog        title: qsTr("选择文件夹")        selectExisting: true        selectMultiple: false        onAccepted: {            const folderPath = fileUrl.toString().replace("file:///", "").replace(/\//g, "\\")            // 检查是否已存在            let exists = false            for (let i = 0; i < foldersModel.count; i++) {                if (foldersModel.get(i).folderPath === folderPath) {                    exists = true                    break                }            }            if (!exists) {                foldersModel.append({ folderPath: folderPath })            }        }    }    // 消息对话框    MessageDialog {        id: messageDialog        title: qsTr("提示")        standardButtons: MessageDialog.Ok    }}