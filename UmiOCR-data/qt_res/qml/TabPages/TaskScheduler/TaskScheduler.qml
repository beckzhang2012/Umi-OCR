import QtQuick 2.15import QtQuick.Controls 2.15import QtQuick.Layouts 1.15import QtQuick.Dialogs 1.15import QtQuick.Window 2.15import "../Navigation"import "../GlobalConfigsPage"Page {    id: taskSchedulerPage    title: qsTr("任务排程")    property var tasks: []    property var logs: []    Component.onCompleted: {        // 加载任务列表        tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")        // 加载日志        logs = tagPagesConnector.callPySync("TaskScheduler", "get_task_logs")        // 定时刷新任务列表和日志        timer.start()    }    Timer {        id: timer        interval: 5000 // 5秒刷新一次        running: false        repeat: true        onTriggered: {            tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")            logs = tagPagesConnector.callPySync("TaskScheduler", "get_task_logs")        }    }    ColumnLayout {        anchors.fill: parent        spacing: 10        // 工具栏        RowLayout {            Layout.fillWidth: true            Button {                text: qsTr("添加任务")                onClicked: addTaskDialog.open()            }            Button {                text: qsTr("导出日志")                onClicked: exportLogsDialog.open()            }            Button {                text: qsTr("清除日志")                onClicked: {                    if (confirmDialog.visible) return                    confirmDialog.title = qsTr("确认清除日志")                    confirmDialog.text = qsTr("确定要清除所有任务执行日志吗？此操作不可恢复。")                    confirmDialog.accepted.connect(() => {                        tagPagesConnector.callPy("TaskScheduler", "clear_logs")                        logs = tagPagesConnector.callPySync("TaskScheduler", "get_task_logs")                    })                    confirmDialog.open()                }            }        }        // 任务列表        ScrollView {            Layout.fillWidth: true            Layout.fillHeight: true            TableView {                id: taskTable                model: tasks                width: parent.width                height: parent.height                TableViewColumn {                    role: "name"                    title: qsTr("任务名称")                    width: 150                }                TableViewColumn {                    role: "type"                    title: qsTr("任务类型")                    width: 100                    delegate: Text {                        text: {                            switch (model.type) {                                case "once": return qsTr("一次性")                                case "daily": return qsTr("每天")                                case "weekly": return qsTr("每周")                                case "cron": return qsTr("自定义")                                default: return model.type                            }                        }                    }                }                TableViewColumn {                    role: "schedule"                    title: qsTr("执行时间")                    width: 150                    delegate: Text {                        text: {                            if (model.type === "once") {                                return model.schedule                            } else if (model.type === "daily") {                                return qsTr("每天 %1").arg(model.schedule)                            } else if (model.type === "weekly") {                                const weekdays = [qsTr("周日"), qsTr("周一"), qsTr("周二"), qsTr("周三"), qsTr("周四"), qsTr("周五"), qsTr("周六")]                                return qsTr("每周 %1 %2").arg(weekdays[model.schedule.weekday]).arg(model.schedule.time)                            } else if (model.type === "cron") {                                return model.schedule                            } else {                                return ""                            }                        }                    }                }                TableViewColumn {                    role: "next_execution_time"                    title: qsTr("下次执行")                    width: 150                    delegate: Text {                        text: model.next_execution_time ? model.next_execution_time : qsTr("已过期")                    }                }                TableViewColumn {                    role: "status"                    title: qsTr("状态")                    width: 80                    delegate: Text {                        text: model.status === "running" ? qsTr("运行中") : qsTr("已暂停")                        color: model.status === "running" ? "green" : "red"                    }                }                TableViewColumn {                    title: qsTr("操作")                    width: 200                    delegate: RowLayout {                        Button {                            text: qsTr("编辑")                            onClicked: editTaskDialog.open(model)                        }                        Button {                            text: model.status === "running" ? qsTr("暂停") : qsTr("启动")                            onClicked: {                                if (model.status === "running") {                                    tagPagesConnector.callPy("TaskScheduler", "pause_task", [model.id])                                } else {                                    tagPagesConnector.callPy("TaskScheduler", "start_task", [model.id])                                }                                tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")                            }                        }                        Button {                            text: qsTr("立即执行")                            onClicked: tagPagesConnector.callPy("TaskScheduler", "run_task_now", [model.id])                        }                        Button {                            text: qsTr("删除")                            onClicked: {                                if (confirmDialog.visible) return                                confirmDialog.title = qsTr("确认删除任务")                                confirmDialog.text = qsTr("确定要删除任务 '%1' 吗？此操作不可恢复。").arg(model.name)                                confirmDialog.accepted.connect(() => {                                    tagPagesConnector.callPy("TaskScheduler", "delete_task", [model.id])                                    tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")                                })                                confirmDialog.open()                            }                        }                    }                }            }        }        // 日志列表        ScrollView {            Layout.fillWidth: true            Layout.preferredHeight: 200            TableView {                id: logTable                model: logs                width: parent.width                height: parent.height                TableViewColumn {                    role: "start_time"                    title: qsTr("开始时间")                    width: 150                }                TableViewColumn {                    role: "task_name"                    title: qsTr("任务名称")                    width: 150                }                TableViewColumn {                    role: "status"                    title: qsTr("状态")                    width: 80                    delegate: Text {                        text: model.status === "success" ? qsTr("成功") : qsTr("失败")                        color: model.status === "success" ? "green" : "red"                    }                }                TableViewColumn {                    role: "success_count"                    title: qsTr("成功数量")                    width: 80                }                TableViewColumn {                    role: "failure_count"                    title: qsTr("失败数量")                    width: 80                }                TableViewColumn {                    role: "errors"                    title: qsTr("错误信息")                    width: 200                    delegate: Text {                        text: model.errors.join("\n")                        wrapMode: Text.WordWrap                    }                }            }        }    }    // 添加任务对话框    AddTaskDialog {        id: addTaskDialog        onTaskAdded: {            tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")        }    }    // 编辑任务对话框    EditTaskDialog {        id: editTaskDialog        onTaskUpdated: {            tasks = tagPagesConnector.callPySync("TaskScheduler", "get_tasks")        }    }    // 导出日志对话框    FileDialog {        id: exportLogsDialog        title: qsTr("导出日志")        selectExisting: false        selectMultiple: false        nameFilters: [qsTr("JSON文件 (*.json)"), qsTr("所有文件 (*)")]        onAccepted: {            tagPagesConnector.callPy("TaskScheduler", "export_logs", [fileUrl.toString().replace("file:///", "").replace(/\//g, "\\")])        }    }    // 确认对话框    Dialog {        id: confirmDialog        standardButtons: Dialog.Ok | Dialog.Cancel        onAccepted: {            confirmDialog.accepted.disconnect()        }    }}