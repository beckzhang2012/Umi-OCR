// ========================================// =============== 审阅看板页 ===============// ========================================import QtQuick 2.15import QtQuick.Controls 2.15import QtQuick.Layouts 1.15import QtQuick.Window 2.15import UmiOCR 1.0Page {    id: reviewBoardPage    title: qsTr("审阅看板")    property string ctrlKey: ""    property var reviewItems: []    property var currentFilter: {}    property string currentSortKey: "timestamp"    property string currentSortOrder: "desc"    // 初始化    Component.onCompleted: {        // 获取控制器key        ctrlKey = tagPages.addPage("ReviewBoard")        if (ctrlKey) {            // 设置qml对象            tagPages.setPageQmlObj(ctrlKey, reviewBoardPage)            // 加载初始数据            refreshReviewItems()        }    }    // 刷新审阅项列表    function refreshReviewItems() {        if (ctrlKey) {            reviewItems = tagPages.callPy(ctrlKey, "get_review_items", [currentFilter, [currentSortKey, currentSortOrder]])        }    }    // 添加OCR结果    function addOCRResult(result) {        if (ctrlKey) {            tagPages.callPy(ctrlKey, "add_ocr_result_from_qml", [result])            refreshReviewItems()        }    }    // 更新审阅项    function updateReviewItem(itemId, updates) {        if (ctrlKey) {            tagPages.callPy(ctrlKey, "update_review_item_from_qml", [itemId, updates])            refreshReviewItems()        }    }    // 删除审阅项    function deleteReviewItem(itemId) {        if (ctrlKey) {            tagPages.callPy(ctrlKey, "delete_review_item_from_qml", [itemId])            refreshReviewItems()        }    }    // 批量更新审阅项    function batchUpdateItems(itemIds, updates) {        if (ctrlKey) {            tagPages.callPy(ctrlKey, "batch_update_items_from_qml", [itemIds, updates])            refreshReviewItems()        }    }    // 批量删除审阅项    function batchDeleteItems(itemIds) {        if (ctrlKey) {            tagPages.callPy(ctrlKey, "batch_delete_items_from_qml", [itemIds])            refreshReviewItems()        }    }    // 导出为Markdown    function exportAsMarkdown(exportPath) {        if (ctrlKey) {            return tagPages.callPy(ctrlKey, "export_as_markdown_from_qml", [reviewItems, exportPath])        }        return false    }    // 导出为HTML    function exportAsHtml(exportPath) {        if (ctrlKey) {            return tagPages.callPy(ctrlKey, "export_as_html_from_qml", [reviewItems, exportPath])        }        return false    }    // 设置过滤条件    function setFilter(filters) {        currentFilter = filters        if (ctrlKey) {            tagPages.callPy(ctrlKey, "set_filter", [filters])        }        refreshReviewItems()    }    // 设置排序条件    function setSort(sortKey, sortOrder) {        currentSortKey = sortKey        currentSortOrder = sortOrder        if (ctrlKey) {            tagPages.callPy(ctrlKey, "set_sort", [sortKey, sortOrder])        }        refreshReviewItems()    }    // 主要布局    ColumnLayout {        anchors.fill: parent        spacing: 10        // 工具栏        RowLayout {            Layout.fillWidth: true            spacing: 10            // 搜索框            TextField {                id: searchTextField                Layout.preferredWidth: 200                placeholderText: qsTr("搜索文本或路径")                onEditingFinished: {                    setFilter({                        search: searchTextField.text                    })                }            }            // 状态筛选            ComboBox {                id: statusComboBox                Layout.preferredWidth: 120                model: [qsTr("全部状态"), qsTr("未处理"), qsTr("已校对"), qsTr("待修改"), qsTr("已完成")]                onCurrentTextChanged: {                    if (statusComboBox.currentText === qsTr("全部状态")) {                        setFilter({})                    } else {                        setFilter({                            status: statusComboBox.currentText                        })                    }                }            }            // 排序选择            ComboBox {                id: sortComboBox                Layout.preferredWidth: 150                model: [qsTr("按时间倒序"), qsTr("按时间正序"), qsTr("按置信度倒序"), qsTr("按置信度正序")]                onCurrentTextChanged: {                    if (sortComboBox.currentText === qsTr("按时间倒序")) {                        setSort("timestamp", "desc")                    } else if (sortComboBox.currentText === qsTr("按时间正序")) {                        setSort("timestamp", "asc")                    } else if (sortComboBox.currentText === qsTr("按置信度倒序")) {                        setSort("confidence", "desc")                    } else if (sortComboBox.currentText === qsTr("按置信度正序")) {                        setSort("confidence", "asc")                    }                }            }            // 导出按钮            Button {                id: exportButton                text: qsTr("导出")                onClicked: {                    // 这里需要实现文件选择对话框                    // 暂时使用默认路径                    var exportPath = "review_board_report.md"                    var success = exportAsMarkdown(exportPath)                    if (success) {                        messageBox.show(qsTr("导出成功"), qsTr("报告已导出到: ") + exportPath)                    } else {                        messageBox.show(qsTr("导出失败"), qsTr("导出过程中发生错误"))                    }                }            }        }        // 列表视图        ListView {            id: reviewItemsListView            Layout.fillWidth: true            Layout.fillHeight: true            model: reviewItems            delegate: ReviewItemDelegate {                id: reviewItemDelegate                itemData: modelData                onUpdate: {                    updateReviewItem(itemData.id, {                        status: reviewItemDelegate.statusComboBox.currentText,                        tags: reviewItemDelegate.tagsTextField.text.split(",").map(tag => tag.trim()),                        assignee: reviewItemDelegate.assigneeTextField.text,                        comments: reviewItemDelegate.commentsTextArea.text                    })                }                onDelete: {                    deleteReviewItem(itemData.id)                }            }            // 没有数据时的提示            Component.onCompleted: {                if (reviewItemsListView.count === 0) {                    reviewItemsListView.addItem(createEmptyItem())                }            }            function createEmptyItem() {                var emptyItem = Qt.createQmlObject('import QtQuick 2.15; Item { height: 100; Text { anchors.centerIn: parent; text: qsTr("暂无审阅项"); color: "#999" } }', reviewItemsListView.contentItem)                return emptyItem            }        }    }    // 审阅项委托    Component {        id: ReviewItemDelegate        Item {            id: reviewItemDelegate            width: ListView.view.width            height: 150            property var itemData: {}            signal update            signal delete            ColumnLayout {                anchors.fill: parent                spacing: 5                // 标题栏                RowLayout {                    Layout.fillWidth: true                    spacing: 10                    // 缩略图                    Image {                        id: thumbnailImage                        Layout.preferredWidth: 80                        Layout.preferredHeight: 80                        source: itemData.thumbnail_path                        fillMode: Image.PreserveAspectFit                        placeholder: Rectangle {                            width: 80                            height: 80                            color: "#eee"                            Text {                                anchors.centerIn: parent                                text: qsTr("缩略图")                                color: "#999"                                font.pixelSize: 10                            }                        }                    }                    // 基本信息                    ColumnLayout {                        Layout.fillWidth: true                        spacing: 3                        Text {                            id: sourcePathText                            text: itemData.source_path                            elide: Text.ElideLeft                            color: "#666"                            font.pixelSize: 12                        }                        Text {                            id: timestampText                            text: new Date(itemData.timestamp * 1000).toLocaleString()                            color: "#999"                            font.pixelSize: 10                        }                        Text {                            id: confidenceText                            text: qsTr("置信度: ") + (itemData.confidence * 100).toFixed(0) + "%"                            color: "#999"                            font.pixelSize: 10                        }                    }                    // 删除按钮                    Button {                        id: deleteButton                        text: qsTr("删除")                        font.pixelSize: 10                        onClicked: {                            reviewItemDelegate.delete()                        }                    }                }                // 文本摘要                Text {                    id: textSummaryText                    text: itemData.text_content.length > 200 ? itemData.text_content.substring(0, 200) + "..." : itemData.text_content                    elide: Text.ElideRight                    color: "#333"                    font.pixelSize: 12                    wrapMode: Text.WordWrap                    Layout.fillWidth: true                    Layout.maximumHeight: 60                }                // 操作栏                RowLayout {                    Layout.fillWidth: true                    spacing: 10                    // 状态选择                    ComboBox {                        id: statusComboBox                        Layout.preferredWidth: 100                        model: [qsTr("未处理"), qsTr("已校对"), qsTr("待修改"), qsTr("已完成")]                        currentIndex: model.indexOf(itemData.status)                        font.pixelSize: 10                    }                    // 负责人                    TextField {                        id: assigneeTextField                        Layout.preferredWidth: 100                        placeholderText: qsTr("负责人")                        text: itemData.assignee                        font.pixelSize: 10                    }                    // 标签                    TextField {                        id: tagsTextField                        Layout.preferredWidth: 150                        placeholderText: qsTr("标签")                        text: itemData.tags.join(",")                        font.pixelSize: 10                    }                    // 备注                    TextField {                        id: commentsTextField                        Layout.fillWidth: true                        placeholderText: qsTr("备注")                        text: itemData.comments                        font.pixelSize: 10                    }                    // 保存按钮                    Button {                        id: saveButton                        text: qsTr("保存")                        font.pixelSize: 10                        onClicked: {                            reviewItemDelegate.update()                        }                    }                }            }            // 分割线            Rectangle {                id: separator                width: parent.width                height: 1                color: "#eee"                anchors.bottom: parent.bottom            }        }    }    // 消息框组件    Component {        id: MessageBox        Dialog {            id: messageBox            title: ""            text: ""            modal: true            standardButtons: Dialog.Ok            function show(titleText, messageText) {                messageBox.title = titleText                messageBox.text = messageText                messageBox.open()            }        }    }    // 延迟创建消息框    property var messageBox: null    function initMessageBox() {        if (!messageBox) {            messageBox = MessageBox.createObject(reviewBoardPage)        }    }    Component.onCompleted: {        initMessageBox()    }